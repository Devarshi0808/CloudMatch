# Required for real-time marketplace search. Tavily's free plan needs no card.
# Never commit the real value; configure it locally and in Vercel.
TAVILY_API_KEY=tvly-your-key

# Optional: fast is the evaluated one-credit default. Basic also costs one
# credit; advanced costs two and had worse tail latency in CloudMatch's suite.
TAVILY_SEARCH_DEPTH=fast
